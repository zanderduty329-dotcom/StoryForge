{
  "name": "storyforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered storytelling & world-building platform with persistent Story Bible memory, RPG/DM mode, and live multiplayer sessions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create storyforge-db",
    "db:migrate": "wrangler d1 execute storyforge-db --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute storyforge-db --local --file=src/db/schema.sql",
    "vector:create": "wrangler vectorize create storyforge-memory --dimensions=768 --metric=cosine",
    "r2:create": "wrangler r2 bucket create storyforge-assets",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@cloudflare/vite-plugin": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-react": "^4.3.0",
    "wrangler": "^4.0.0"
  }
}
