:root {
  font-family: Arial, sans-serif;
  color: #f5f5f5;
  background: #111827;
  --border: #374151;
  --text-muted: #9ca3af;
  --text-secondary: #d1d5db;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

button {
  cursor: pointer;
}

.app-layout {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 220px;
  padding: 20px;
  background: #1f2937;
  display: flex;
  flex-direction: column;
}

.sidebar-logo {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 20px;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-item {
  background: transparent;
  color: white;
  border: 0;
  padding: 10px;
  text-align: left;
  border-radius: 8px;
}

.nav-item.active,
.nav-item:hover {
  background: #374151;
}

.nav-icon {
  margin-right: 8px;
}

.main-content {
  flex: 1;
  padding: 24px;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.content-area {
  margin-top: 24px;
}

.btn {
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #4b5563;
  background: #374151;
  color: white;
}


/* StoryForge Map Builder v1 */
.card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
  background: #1f2937;
}

.form-input {
  width: 100%;
  padding: 8px 10px;
  margin-top: 5px;
  border-radius: 8px;
  border: 1px solid #4b5563;
  background: #111827;
  color: inherit;
}

.btn-primary {
  background: #2563eb;
}

.btn-secondary {
  background: #374151;
}

.btn-sm {
  padding: 6px 9px;
}

.empty-state {
  border: 1px dashed var(--border);
  border-radius: 12px;
  padding: 36px;
  text-align: center;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 42px;
  margin-bottom: 10px;
}

.sf-map-builder {
  display: grid;
  grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

.sf-map-sidebar {
  display: grid;
  gap: 14px;
}

.sf-map-panel {
  display: grid;
  gap: 10px;
}

.sf-map-panel h3 {
  margin: 0 0 4px;
}

.sf-map-panel label {
  display: block;
}

.sf-map-list,
.sf-map-location-list {
  display: grid;
  gap: 7px;
}

.sf-map-list button,
.sf-map-location-list button {
  width: 100%;
  text-align: left;
}

.sf-map-colors {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.sf-map-colors label {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 7px;
  font-size: 12px;
}

.sf-map-colors input[type="color"] {
  display: block;
  width: 100%;
  height: 34px;
  margin-top: 5px;
  padding: 0;
  border: 0;
  background: transparent;
}

.sf-map-button-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.sf-map-main {
  min-width: 0;
}

.sf-map-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 12px;
}

.sf-map-heading h2,
.sf-map-heading p {
  margin: 0;
}

.sf-map-heading p {
  margin-top: 5px;
  color: var(--text-muted);
}

.sf-map-placement-notice {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px;
  font-weight: bold;
}

.sf-map-canvas {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border: 3px solid;
  border-radius: 12px;
  background-image:
    linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px),
    linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px);
  background-size: 32px 32px;
  box-shadow: inset 0 0 60px rgb(0 0 0 / 18%);
}

.sf-map-canvas-painting {
  cursor: crosshair;
}

.sf-map-terrain {
  position: absolute;
  transform: translate(-50%, -50%);
  border-radius: 48% 52% 44% 56%;
  border: 1px solid rgb(0 0 0 / 18%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: none;
  opacity: 0.94;
}

.sf-map-terrain-water {
  border-radius: 54% 46% 52% 48%;
}

.sf-map-terrain-desert,
.sf-map-terrain-plains {
  opacity: 0.88;
}

.sf-map-terrain-symbol {
  font-size: clamp(16px, 3vw, 34px);
  filter: drop-shadow(0 1px 1px rgb(0 0 0 / 25%));
}

.sf-map-marker {
  position: absolute;
  transform: translate(-50%, -50%);
  border: 0;
  background: transparent;
  padding: 0;
  color: inherit;
  text-align: center;
  z-index: 10;
}

.sf-map-marker-icon {
  display: block;
  font-size: clamp(20px, 3vw, 34px);
  line-height: 1;
  filter: drop-shadow(0 1px 2px rgb(0 0 0 / 45%));
}

.sf-map-marker-label {
  display: block;
  margin-top: 3px;
  padding: 2px 5px;
  border-radius: 5px;
  background: rgb(255 255 255 / 70%);
  color: #111827;
  font-size: 12px;
  font-weight: bold;
  white-space: nowrap;
}

.sf-map-marker:hover .sf-map-marker-label,
.sf-map-marker:focus-visible .sf-map-marker-label {
  background: white;
}

.sf-map-help {
  color: var(--text-muted);
  font-size: 13px;
}

.sf-map-location-editor {
  margin-top: 16px;
}

.sf-map-editor-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 10px;
}

.sf-map-textarea {
  min-height: 90px;
  resize: vertical;
}

.sf-map-editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

@media (max-width: 900px) {
  .sf-map-builder {
    grid-template-columns: 1fr;
  }

  .sf-map-sidebar {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
}

@media (max-width: 620px) {
  .main-content {
    padding: 14px;
  }

  .sf-map-editor-grid {
    grid-template-columns: 1fr;
  }

  .sf-map-colors {
    grid-template-columns: 1fr 1fr;
  }

  .sf-map-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .sf-map-canvas {
    aspect-ratio: 4 / 3;
  }
}


/* StoryForge Map Editor v2 */

.sf-map-library-v2 {
  display: grid;
  gap: 18px;
}

.sf-map-library-heading h2,
.sf-map-library-heading p {
  margin: 0;
}

.sf-map-library-heading p {
  margin-top: 5px;
  color: var(--text-muted);
}

.sf-map-create-card-v2 {
  display: grid;
  gap: 12px;
}

.sf-map-create-card-v2 h3 {
  margin: 0;
}

.sf-map-create-grid-v2 {
  display: grid;
  grid-template-columns:
    minmax(220px, 2fr)
    minmax(160px, 1fr);
  gap: 12px;
}

.sf-map-library-grid-v2 {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
}

.sf-map-library-item-v2 {
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.sf-map-library-item-v2 strong,
.sf-map-library-item-v2 span,
.sf-map-library-item-v2 small {
  display: block;
}

.sf-map-library-item-v2 span {
  margin-top: 5px;
}

.sf-map-library-item-v2 small {
  margin-top: 10px;
  color: var(--text-muted);
}

.sf-map-editor-v2 {
  display: grid;
  gap: 10px;
}

.sf-map-editor-titlebar-v2 {
  display: flex;
  align-items: center;
  gap: 12px;
}

.sf-map-editor-name-v2 {
  flex: 1;
}

.sf-map-editor-name-v2 strong,
.sf-map-editor-name-v2 span {
  display: block;
}

.sf-map-editor-name-v2 span {
  margin-top: 2px;
  color: var(--text-muted);
  font-size: 13px;
}

.sf-map-autosave-v2 {
  color: var(--text-muted);
  font-size: 13px;
}

.sf-map-toolbar-v2 {
  position: sticky;
  top: 0;
  z-index: 40;
  display: grid;
  gap: 7px;
  padding: 9px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #1f2937;
}

.sf-map-toolbar-group-v2 {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.sf-map-toolbar-group-v2 > button {
  flex: 0 0 auto;
  white-space: nowrap;
}

.sf-map-brush-control-v2 {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
  padding: 0 8px;
  border: 1px solid #4b5563;
  border-radius: 8px;
  background: #374151;
}

.sf-map-brush-control-v2 input {
  width: 100px;
}

.sf-map-settings-v2 {
  display: grid;
  gap: 12px;
}

.sf-map-settings-grid-v2 {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.sf-map-color-row-v2 {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(90px, 1fr));
  gap: 8px;
}

.sf-map-color-row-v2 label {
  padding: 7px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 12px;
}

.sf-map-color-row-v2 input[type="color"] {
  display: block;
  width: 100%;
  height: 32px;
  margin-top: 4px;
  padding: 0;
  border: 0;
  background: transparent;
}

.sf-map-canvas-wrap-v2 {
  width: 100%;
  overflow: auto;
}

.sf-map-canvas-v2 {
  position: relative;
  width: 100%;
  min-height: 520px;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border: 3px solid;
  border-radius: 10px;
  box-shadow:
    inset 0 0 70px rgb(0 0 0 / 16%);
  touch-action: none;
  user-select: none;
}

.sf-map-grid-visible-v2 {
  background-image:
    linear-gradient(
      rgb(255 255 255 / 12%) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgb(255 255 255 / 12%) 1px,
      transparent 1px
    );
  background-size: 4% 4%;
}

.sf-map-drawing-v2 {
  cursor: crosshair;
}

.sf-map-stroke-v2 {
  position: absolute;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.sf-map-stroke-freehand-v2 {
  border-radius:
    48% 52% 46% 54% /
    54% 46% 55% 45%;
}

.sf-map-stroke-grid-v2 {
  border-radius: 0;
}

.sf-map-marker-v2 {
  position: absolute;
  z-index: 20;
  transform: translate(-50%, -50%);
  border: 0;
  background: transparent;
  color: inherit;
  text-align: center;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.sf-map-marker-icon-v2 {
  display: none;
}

.sf-map-marker-symbol-v3 {
  display: block;
  flex: 0 0 auto;
  line-height: 0;
  filter:
    drop-shadow(0 1px 1px rgb(0 0 0 / 28%));
}

.sf-map-marker-symbol-v3 svg {
  display: block;
  width: 100%;
  height: 100%;
}

.sf-map-marker-size-tiny-v3 {
  width: 13px;
  height: 13px;
}

.sf-map-marker-size-small-v3 {
  width: 19px;
  height: 19px;
}

.sf-map-marker-size-medium-v3 {
  width: 28px;
  height: 28px;
}

.sf-map-marker-size-large-v3 {
  width: 40px;
  height: 40px;
}

.sf-map-marker-label-v2 {
  display: block;
  margin-bottom: 2px;
  padding: 2px 5px;
  border-radius: 5px;
  background: rgb(255 255 255 / 76%);
  color: #111827;
  font-size: 11px;
  font-weight: bold;
  line-height: 1.1;
  white-space: nowrap;
}

.sf-map-canvas-message-v2 {
  position: absolute;
  z-index: 30;
  left: 50%;
  top: 16px;
  transform: translateX(-50%);
  padding: 8px 12px;
  border-radius: 8px;
  background: rgb(17 24 39 / 90%);
  color: white;
  font-weight: bold;
  pointer-events: none;
}

.sf-map-statusbar-v2 {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  padding: 7px 2px;
  color: var(--text-muted);
  font-size: 12px;
}

.sf-map-location-editor-v2 {
  display: grid;
  gap: 10px;
}

.sf-map-location-editor-title-v2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.sf-map-location-editor-title-v2 h3 {
  margin: 0;
}

.sf-map-location-grid-v2 {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.sf-map-location-notes-v2 {
  min-height: 90px;
  resize: vertical;
}

.sf-map-location-actions-v2 {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

@media (max-width: 760px) {
  .sf-map-create-grid-v2,
  .sf-map-settings-grid-v2,
  .sf-map-location-grid-v2 {
    grid-template-columns: 1fr;
  }

  .sf-map-editor-titlebar-v2 {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .sf-map-autosave-v2 {
    width: 100%;
  }

  .sf-map-canvas-v2 {
    min-height: 420px;
    aspect-ratio: 4 / 3;
  }
}



/* StoryForge Map Brush Engine v2.1 */

.sf-map-brush-control-v2 select {
  min-width: 90px;
  padding: 5px 7px;
  border: 1px solid #4b5563;
  border-radius: 6px;
  background: #111827;
  color: white;
}

.sf-map-stroke-freehand-v2 {
  opacity: 0.96;
}



/* StoryForge Terrain Identity v1 */

.sf-map-terrain-style-v1 {
  min-width: 185px;
}

.sf-map-terrain-symbol-v1 {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family:
    Georgia,
    "Times New Roman",
    serif;
  font-size: clamp(7px, 1.15vw, 19px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1px;
  opacity: 0.75;
  white-space: nowrap;
  pointer-events: none;
  user-select: none;
}



/* StoryForge Region Foundation v1 */

.sf-map-region-name-v1 {
  width: 150px;
  padding: 5px 7px;
  border: 1px solid #4b5563;
  border-radius: 6px;
  background: #111827;
  color: white;
}

.sf-map-area-hint-v1 {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  padding: 0 8px;
  color: var(--text-muted);
  font-size: 12px;
}

.sf-map-area-preview-v1 {
  position: absolute;
  z-index: 35;
  border: 2px dashed rgb(255 255 255 / 85%);
  background: rgb(255 255 255 / 10%);
  pointer-events: none;
}

.sf-map-region-cell-v1 {
  position: absolute;
  z-index: 8;
  pointer-events: none;
}

.sf-map-region-biome-v1 {
  opacity: 0.82;
}

.sf-map-region-feature-v1 {
  z-index: 10;
  opacity: 0.82;
}

.sf-map-region-political-v1 {
  z-index: 12;
  opacity: 0.15;
  outline: 1px solid rgb(255 255 255 / 12%);
}



/* -----------------------------------------------
   Map Location searchable picker
   ----------------------------------------------- */

.sf-map-location-picker-wrap-v3 {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.sf-map-location-picker-v3 {
  position: absolute;
  z-index: 100;
  top: calc(100% + 7px);
  right: 0;
  width: min(280px, calc(100vw - 32px));
  padding: 8px;
  border: 1px solid rgb(148 163 184 / 32%);
  border-radius: 10px;
  background: rgb(15 23 42 / 97%);
  box-shadow:
    0 12px 30px rgb(0 0 0 / 38%);
}

.sf-map-location-search-v3 {
  width: 100%;
}

.sf-map-location-results-v3 {
  display: grid;
  gap: 4px;
  max-height: 260px;
  margin-top: 7px;
  overflow-y: auto;
}

.sf-map-location-option-v3 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  padding: 8px 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.sf-map-location-option-v3:hover,
.sf-map-location-option-v3:focus-visible {
  background: rgb(148 163 184 / 16%);
  outline: none;
}

.sf-map-location-option-v3 strong {
  font-size: 13px;
}

.sf-map-location-option-v3 span {
  color: rgb(148 163 184);
  font-size: 11px;
  white-space: nowrap;
}

.sf-map-location-empty-v3 {
  padding: 12px 8px;
  color: rgb(148 163 184);
  font-size: 12px;
  text-align: center;
}
