{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storyforge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  },
    "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storyforge-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "storyforge-memory"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "storyforge-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_SESSION",
        "class_name": "WorldSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorldSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}

